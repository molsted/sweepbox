<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PkgCleaner.Desktop.App"
             Name="PkgCleaner"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Brand orange: drives Fluent's accent (buttons, toggles, focus, selection). -->
            <Color x:Key="BrandOrange">#EA580C</Color>
            <Color x:Key="BrandAmber">#FBB024</Color>
            <SolidColorBrush x:Key="BrandOrangeBrush" Color="{StaticResource BrandOrange}" />
            <LinearGradientBrush x:Key="BrandGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="{StaticResource BrandOrange}" />
                <GradientStop Offset="1" Color="{StaticResource BrandAmber}" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="FailureBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="MutedBrush" Color="#888888" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#EA580C" />
                <ColorPaletteResources x:Key="Dark" Accent="#F97316" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrandOrangeBrush}" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Border.header">
            <Setter Property="Background" Value="{StaticResource BrandGradient}" />
            <Setter Property="Padding" Value="20,16" />
        </Style>
        <Style Selector="Border.header TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Application.Styles>
</Application>
