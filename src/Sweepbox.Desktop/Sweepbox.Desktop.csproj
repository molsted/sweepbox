<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Every restore (and the lock file graph) covers exactly these; installers publish with -r from this list. -->
    <RuntimeIdentifiers>osx-arm64;osx-x64;win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Sweepbox</AssemblyName>
    <RootNamespace>Sweepbox.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Self-contained single-file publish for the installers -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- NetSparkle's dialog windows in Updates/ are constructed by SweepboxUIFactory, never via the runtime XAML loader;
         they intentionally have no parameterless constructor, so AVLN3001 does not apply. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The NetSparkle Ed25519 public key; the matching private key lives only in CI (SPARKLE_PRIVATE_KEY). -->
    <EmbeddedResource Include="..\..\installer\sparkle-public-key.txt" />
    <!-- Shipped next to the executable (and opened from the status window). -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK auto-references ILLink.Tasks with a version derived from the machine's installed
         runtime, which breaks restore-locked CI (the version drifts with the runner image). An
         explicit reference wins over the auto-injected one and keeps the lock file stable;
         upgrade it together with the lock files. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.15" />
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- NetSparkle 4.0 preview is the Avalonia 12 line; core 3.1.1-preview pairs with it. -->
    <PackageReference Include="NetSparkleUpdater.SparkleUpdater" Version="3.1.1-preview20261011001" />
    <PackageReference Include="NetSparkleUpdater.UI.Avalonia" Version="4.0.0-preview20261011001" />
    <!-- Transitive (Linux D-Bus) dependency of Avalonia; pinned to the patched release (GHSA-xrw6-gwf8-vvr9). -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sweepbox.Core\Sweepbox.Core.csproj" />
  </ItemGroup>
</Project>
