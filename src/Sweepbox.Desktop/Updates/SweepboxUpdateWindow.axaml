<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetSparkleUpdater.UI.Avalonia.ViewModels"
        x:Class="Sweepbox.Desktop.Updates.SweepboxUpdateWindow"
        x:DataType="vm:UpdateAvailableWindowViewModel"
        Title="Sweepbox update"
        Icon="/Assets/app-icon.png"
        Width="480" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border Classes="header" DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Image Source="/Assets/app-icon.png" Width="40" Height="40" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="h1" Text="Update available" />
                    <TextBlock Text="A new version of Sweepbox is ready to install." Opacity="0.9" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Margin="20" Spacing="14">
            <StackPanel Spacing="4">
                <TextBlock Classes="h2" Text="What's new" />
                <TextBlock TextWrapping="Wrap" Text="{Binding InfoText}" />
            </StackPanel>

            <Border Classes="card" IsVisible="{Binding AreReleaseNotesVisible}" Padding="14,10">
                <ScrollViewer MaxHeight="180">
                    <TextBlock x:Name="_notesText" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                <Button Content="Skip this version" Command="{Binding Skip}" IsVisible="{Binding IsSkipVisible}" />
                <Button Content="Remind me later" Command="{Binding RemindMeLater}" IsVisible="{Binding IsRemindMeLaterVisible}" />
                <Button Classes="accent" Content="Install update" Command="{Binding DownloadInstall}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
